{
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/products/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/products",
      "destination": "/api/index.py"
    },
    {
      "source": "/sales/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/sales",
      "destination": "/api/index.py"
    },
    {
      "source": "/purchases/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/purchases",
      "destination": "/api/index.py"
    },
    {
      "source": "/ledger/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/ledger",
      "destination": "/api/index.py"
    },
    {
      "source": "/stock-take/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/reports/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/auth/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/health",
      "destination": "/api/index.py"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
